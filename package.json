{
  "name": "simorgh-cafe-app",
  "version": "1.0.0",
  "private": true,
  "description": "کافه کتاب سیمرغ — اپ اندروید (Capacitor) + سرور Express",
  "scripts": {
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "start": "npm --prefix server/v2 start",
    "db:init": "npm --prefix server/v2 run db:init",
    "admin:seed": "npm --prefix server/v2 run admin:seed",
    "check": "npm --prefix server/v2 run check && node scripts/check-v2.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
